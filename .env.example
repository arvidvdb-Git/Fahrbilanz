# Fahrbilanz Server & B2B Dealer API Configuration

# Server port (dev and production Express entry point)
PORT=3000

# Public canonical domain used for SSR SEO meta, hreflang, and sitemap.xml
APP_URL=https://fahrbilanz.example

# 32+ byte secret used to sign short-lived B2B embed tokens (POST /api/v1/tokens/issue)
FAHRBILANZ_TOKEN_SECRET=replace-with-a-random-64-char-hex-secret

# Set to true in production to require X-API-Key or Bearer embed token on /api/v1/calculate, /sensitivity, /energy-map
FAHRBILANZ_REQUIRE_API_KEY=true

# Semicolon-separated B2B dealer registry:
# format: <apiKey>:<tenantId>:<comma-separated-allowed-origins-or-*>
FAHRBILANZ_DEALER_KEYS=dealer_live_key_example:autohaus-mueller:https://www.autohaus-mueller.de,https://app.autohaus-mueller.de

# Sliding-window rate limit per tenant/IP per minute
FAHRBILANZ_RATE_LIMIT_PER_MIN=60
